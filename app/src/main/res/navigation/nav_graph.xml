<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_staffDashboardFragment"
            app:destination="@id/staffDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_submitReportFragment"
            app:destination="@id/submitReportFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_myReportsFragment"
            app:destination="@id/myReportsFragment" />
    </fragment>

    <fragment
        android:id="@+id/myReportsFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.reports.MyReportsFragment"
        android:label="My Reports"
        tools:layout="@layout/fragment_my_reports">
        <action
            android:id="@+id/action_myReportsFragment_to_reportDetailsFragment"
            app:destination="@id/reportDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/submitReportFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.report.CreateReportFragment"
        android:label="Submit Report"
        tools:layout="@layout/fragment_create_report" />

    <fragment
        android:id="@+id/reportDetailsFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.reports.ReportDetailsFragment"
        android:label="Report Details"
        tools:layout="@layout/fragment_report_details">
        <argument
            android:name="reportId"
            app:argType="integer" />
        <action
            android:id="@+id/action_reportDetailsFragment_to_editReportFragment"
            app:destination="@id/editReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/editReportFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.reports.EditReportFragment"
        android:label="Edit Report"
        tools:layout="@layout/fragment_edit_report">
        <argument
            android:name="reportId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/staffDashboardFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.staff.StaffDashboardFragment"
        android:label="County Staff Dashboard"
        tools:layout="@layout/fragment_staff_dashboard">
        <action
            android:id="@+id/action_staffDashboardFragment_to_reportDetailsFragment"
            app:destination="@id/reportDetailsFragment" />
        <action
            android:id="@+id/action_staffDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/staffDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
