<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_reportListFragment"
            app:destination="@id/reportListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_staffDashboardFragment"
            app:destination="@id/staffDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/reportListFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.report.ReportListFragment"
        android:label="My Reports"
        tools:layout="@layout/fragment_report_list">
        <action
            android:id="@+id/action_reportListFragment_to_createReportFragment"
            app:destination="@id/createReportFragment" />
        <action
            android:id="@+id/action_reportListFragment_to_reportDetailFragment"
            app:destination="@id/reportDetailFragment" />
        <action
            android:id="@+id/action_reportListFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/reportListFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/createReportFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.report.CreateReportFragment"
        android:label="New Report"
        tools:layout="@layout/fragment_create_report" />

    <fragment
        android:id="@+id/reportDetailFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.report.ReportDetailFragment"
        android:label="Report Details"
        tools:layout="@layout/fragment_report_detail" />

    <fragment
        android:id="@+id/staffDashboardFragment"
        android:name="com.example.communityinfrastructurereportingsystem.ui.staff.StaffDashboardFragment"
        android:label="County Staff Dashboard"
        tools:layout="@layout/fragment_staff_dashboard">
        <action
            android:id="@+id/action_staffDashboardFragment_to_reportDetailFragment"
            app:destination="@id/reportDetailFragment" />
        <action
            android:id="@+id/action_staffDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/staffDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
